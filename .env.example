# =============================================================================
# IMPORTANTE (Vercel / produção)
# -----------------------------------------------------------------------------
# As variáveis NEXT_PUBLIC_SUPABASE_* no Vercel DEVEM ser as do MESMO projeto
# Supabase do .env.local (banco atual / live).
#
# Se o Vercel ainda tiver URL/key de um projeto Supabase ANTIGO, o deploy fala
# com schema/dados errados (ex.: profiles vs organizations, sale_date vs date,
# stock_base_sacas ausente). Confere Environment Variables no painel Vercel.
#
# Não criámos tabelas novas tipo ai_launches. O código adapta-se ao schema live.
# SQL opcional: supabase/adapt-live-schema.sql (só onboarding_completed_at).
# =============================================================================

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
OPENAI_API_KEY=

# Opcional no CI (GitHub Actions keepalive):
# SUPABASE_URL=
# SUPABASE_KEY=
